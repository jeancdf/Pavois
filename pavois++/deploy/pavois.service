[Unit]
Description=Pavois camera detector
Wants=network-online.target systemd-time-wait-sync.service pavois-performance.service
After=network-online.target systemd-time-wait-sync.service pavois-performance.service
Conflicts=pavois-camstream.service

[Service]
Type=simple
User=pavois
Group=pavois
SupplementaryGroups=video
WorkingDirectory=/opt/pavois
EnvironmentFile=-/etc/pavois/telemetry.env
ExecStart=/opt/pavois/bin/pavois_detect --config /etc/pavois/pavois.conf
Restart=always
RestartSec=5
Nice=-5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
