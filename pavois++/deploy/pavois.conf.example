# Local configuration for ONE Pi. The installer sets a unique camera id.
# Edit /etc/pavois/pavois.conf on each Pi before the first deployment.
frames=-1
# Camera thread + two persistent helpers. Keep one Pi core for capture/OS.
processing_threads=3
runtime.pin_threads=true
fusion_window_ms=20

# VPS destination (required to send observations).
# Staging OVH: 41234 (et 41235). Prod: 41234.
output_host=YOUR_VPS_IP_OR_HOSTNAME
output_port=41234

# Camera index from rpicam-hello --list-cameras; no network video source.
camera.0.id=CHANGE_ME
camera.0.device=csi:0
camera.0.enabled=true
camera.0.width=1280
camera.0.height=720
# Bypass old FPS values too. Set limit_fps=true and fps>0 to opt into a limit.
camera.0.limit_fps=false
camera.0.fps=0
camera.0.fov_deg=65.0
# Auto exposure adapts to the rail's lighting. Positive shutter/gain lock it.
camera.0.exposure_mode=sport
camera.0.shutter_us=0
camera.0.analogue_gain=0
camera.0.awb_red_gain=1.0
camera.0.awb_blue_gain=1.0
# Low-latency test confirmation; all valid blobs are sent.
camera.0.confirm_m=2
camera.0.confirm_n=3
# Filled by /opt/pavois/bin/camera-calib.py intrinsics.
# camera.0.fx=...
# camera.0.fy=...
# camera.0.cx=...
# camera.0.cy=...
# camera.0.k1=...
# camera.0.k2=...
# camera.0.p1=...
# camera.0.p2=...
# camera.0.k3=...
# Filled by camera-calib.py rig and used only by the VPS rail bench.
camera.0.rail_pose_enabled=false

# Temporary manual orientation when the IMU is unavailable.
# With a BNO055 on I2C these values are overwritten every frame.
camera.0.heading_deg=0.0
camera.0.elevation_deg=0.0
camera.0.roll_deg=0.0

# Live IMU (BNO055 NDOF). Offsets map chip axes onto the camera.
imu.enabled=true
imu.kind=auto
imu.i2c_dev=/dev/i2c-1
# 0 = probe 0x28 then 0x29. >0 = probe only that address.
imu.i2c_address=0
# Reopen I2C after N consecutive errors; exponential backoff (ms).
imu.i2c_fail_threshold=5
imu.i2c_retry_min_ms=200
imu.i2c_retry_max_ms=5000
# Survives systemctl restart and a full Pi reboot. Absent on first boot.
imu.calib_file=/var/lib/pavois/imu_calib.bin
imu.emit_interval_ms=200
imu.heading_offset_deg=0.0
# Set to -1 only when turning the camera right makes its map cone turn left.
imu.heading_sign=1.0
imu.elevation_offset_deg=0.0
imu.roll_offset_deg=0.0
# 1 = as reported. -1 = flip pitch on an inverted mount.
imu.elevation_sign=1.0
# imu.file=/tmp/pavois_imu.txt
# imu.kind=file

# Chip mounting orientation. heading/elevation/roll offsets above are scalar
# and CANNOT correct a swapped physical axis (chip mounted flat vs. on edge):
# if one Pi's BNO055 lies flat and another's stands on its edge, one Pi's
# roll is the other's pitch, and no offset fixes that -- only a hardware
# axis remap does. imu.axis_map/imu.axis_sign are written to the BNO055's
# AXIS_MAP_CONFIG (0x41) / AXIS_MAP_SIGN (0x42) registers on every init.
#
# Defaults below (0x24 / 0x00) are the chip's power-on-reset values (Bosch
# datasheet position "P1", effectively the identity mapping) -- leave them
# unless you have PHYSICALLY VERIFIED this Pi's actual mounting.
#
# AXIS_MAP_CONFIG bit layout (2 bits per reported axis, 00=chip-X 01=chip-Y
# 10=chip-Z): bits[1:0]=new X source, bits[3:2]=new Y source, bits[5:4]=new
# Z source. AXIS_MAP_SIGN bit layout: bit0=Z sign, bit1=Y sign, bit2=X sign
# (0=positive, 1=inverted). Derive the value for this Pi's enclosure from
# the BNO055 datasheet Sec. 3.4 "Axis Remap" (positions P0-P7), or by
# rotating the mounted chip through each axis and checking that a live
# `imu.file` capture (imu.kind=file) reports heading/roll/elevation moving
# on the axis you actually rotated.
imu.axis_map=0x24
imu.axis_sign=0x00

# Live grayscale preview (2 fps) posted to the VPS via nginx /api/preview.
# Staging OVH: port 8081. Production: 8080.
preview.enabled=true
preview.fps=2
preview.width=320
preview.quality=55
preview.http_port=8081
preview.http_path=/api/preview

# GPS configuration from the VPS frontend is not integrated yet.
# Uncomment and fill these values when needed; do not use example coordinates.
# camera.0.gps_lat=...
# camera.0.gps_lon=...
# camera.0.gps_alt=...

# With one active camera the current runtime emits raw 2D detections over UDP.
# 3D fusion across multiple Pis is not implemented by this deployment.
