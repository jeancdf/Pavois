# CI deploys (deploy-ovh-achraf.yml) regenerate this file from GitHub secrets
# (STAGING_WS_AUTH_TOKEN, ALLOWED_ORIGINS derived from OVH_VPS_HOST) on every
# run -- see DEPLOYMENT.md. Manual edits here only matter for a local/manual
# `./scripts/deploy_staging.sh` run.
UDP_PORT=41234
UDP_HOST=0.0.0.0
PORT=3002
WS_AUTH_TOKEN=staging-token-change-me

# Dump UDP att/raw/obj. Laisser false en staging (sinon ~1e6 lignes/jour).
UDP_VERBOSE=false

ALLOWED_ORIGINS=http://51.91.98.159:8081,http://localhost:8081

# Journal des pistes/alertes (accuracy, historique). docker-compose.staging.yml
# fournit déjà DATABASE_URL (Postgres interne à staging-net) -- ne pas dupliquer.
