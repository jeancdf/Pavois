# CI deploys (deploy-vps.yml / deploy-ovh-achraf.yml) regenerate this file from
# GitHub secrets on every run -- see DEPLOYMENT.md. Manual edits here only
# matter for a local/manual `./scripts/deploy_vps.sh` run.
PAVOIS_API_URL=
PAVOIS_WS_BASE_URL=ws://YOUR_VPS_IP:3002
PAVOIS_DEV_TOKEN=

# Base Postgres des trois docker-compose (*.yml, *.securite.yml, *.staging.yml).
# Chaque fichier a son propre conteneur/volume Postgres ; ce mot de passe est
# partagé entre eux s'ils tournent sur le même hôte, ce qui est sans risque
# (volumes et bases isolés). docker compose refuse de démarrer si vide.
POSTGRES_USER=pavois
POSTGRES_PASSWORD=
POSTGRES_DB=pavois
