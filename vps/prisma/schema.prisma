// The newer "prisma-client" generator emits import.meta.url, which is
// ESM-only -- this project's toolchain (Jest, Nest's default build) is
// CommonJS, and that syntax breaks both `node dist/main.js` and `npm test`
// at runtime (a real crash, not just a lint nit). "prisma-client-js" is the
// stable, CJS-compatible generator; stick with it until the project itself
// moves to ESM.
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

/// One confirmed track_update, from either the fusion pipeline or an `obj*`
/// passthrough line. Kept so detections can be reviewed after the fact to
/// calculate accuracy and spot bad detections.
model Track {
  id             String        @id @default(cuid())
  trackId        String
  lat            Float
  lng            Float
  alt            Float
  classification String?
  // Device-side timestamp (µs), as carried on the wire. Not wall-clock.
  timestampUs    Float
  receivedAt     DateTime      @default(now())

  // Human review for accuracy analysis. Null until someone looks at it.
  verdict        TrackVerdict?
  reviewNote     String?
  reviewedAt     DateTime?

  @@index([receivedAt])
  @@index([trackId])
}

enum TrackVerdict {
  CONFIRMED
  FALSE_POSITIVE
}

enum AlertType {
  INFO
  WARNING
  CRITICAL
}

enum AlertCategory {
  CAMERA_STATUS
  CAMERA_RECOVERED
  SYSTEM_BLIND
  OBJECT_DETECTED
  TO_VERIFY
  DRONE_CONFIRMED
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum CameraState {
  EN_ATTENTE
  OK
  DEGRADED_FROZEN
  DEGRADED_BLIND
  REDUCED_VISIBILITY_NIGHT
  HORS_SERVICE
  RECOVERING
}

/// A notable event worth surfacing to an operator (camera status, object detected,
/// drone confirmed). Persisted so it survives a page refresh.
model Alert {
  id             String        @id @default(cuid())
  type           AlertType
  category       AlertCategory
  status         AlertStatus   @default(NEW)
  message        String
  trackId        String?
  cameraIds      String[]
  cameraState    CameraState?
  confidence     Float?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([createdAt])
  @@index([trackId])
  @@index([status])
}

/// Audit log of camera state transitions.
model CameraStateLog {
  id            String      @id @default(cuid())
  cameraId      String
  state         CameraState
  previousState CameraState?
  reason        String
  lumMean       Float?
  lumStddev     Float?
  exposureUs    Float?
  gainDb        Float?
  createdAt     DateTime    @default(now())

  @@index([cameraId, createdAt])
}
