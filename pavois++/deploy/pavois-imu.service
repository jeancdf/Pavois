[Unit]
Description=Pavois BNO08x orientation reader
After=systemd-udev-trigger.service

[Service]
Type=simple
User=pavois
Group=pavois
SupplementaryGroups=i2c gpio
RuntimeDirectory=pavois-imu
RuntimeDirectoryMode=0750
WorkingDirectory=/run/pavois-imu
ExecStart=/opt/pavois/imu-venv/bin/python /opt/pavois/bno08x_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
