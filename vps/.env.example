UDP_PORT=41234
UDP_HOST=0.0.0.0
PORT=3002
WS_AUTH_TOKEN=change-me
# Positions des caméras modifiées depuis le frontend (volume Docker pavois-data)
CAMERAS_FILE=data/cameras.json
# Réglages à chaud et presets du panneau « Réglages ». Les FUSION_* et
# FUSE_BROADCAST_MS ci-dessous sont les valeurs de démarrage ; ce fichier
# garde ce que le panneau a changé par-dessus.
TUNING_FILE=data/tuning.json
# Régler les détecteurs depuis le panneau exige UDP_HMAC_SECRET, ici et sur
# chaque Pi : un détecteur refuse toute commande de réglage non signée.

# Journal UDP : false par défaut. true (ou 1) dump chaque paquet att/raw/obj.
# Les événements rares (première trame, rejet HMAC, id inconnu) restent en info.
UDP_VERBOSE=false

ALLOWED_ORIGINS=http://localhost:8080
# Historique glissant du service de fusion (SCRUM-57)
FUSION_HISTORY_MS=2000
FUSION_STALE_MS=2000
# Alignement + triangulation (SCRUM-58)
FUSION_WINDOW_MS=20
# Cadence de fusion, et attente max des trames des autres Pi avant de
# fusionner un instant (interpolation plutôt qu'extrapolation).
# 33 ms = une fusion par image caméra à 30 images/s ; à aligner sur la
# cadence de capture des Pi si elle change (22 ms pour 46 images/s).
FUSION_INTERVAL_MS=33
FUSION_LATENCY_MS=80
FUSION_MIN_PARALLAX_DEG=2
# Seuil de reprojection par rayon, en pixels. 120 accepte le banc rail non
# calibré (~110 px) ; passer à ~25 une fois les poses calibrées : c'est ce
# qui élimine les pistes fantômes nées de faux blobs (banc de simulation).
FUSION_MAX_RESIDUAL_PX=120
# Seuil optionnel en mètres (0 = désactivé, remplacé par le seuil pixels).
FUSION_MAX_RESIDUAL_M=0
FUSION_MAX_RANGE_M=60
# Plancher de distance : une intersection plus proche que cela d'une caméra est
# géométriquement impossible pour ce banc et serait affichée collée à la caméra.
FUSION_MIN_RANGE_M=0.5
# Bruit du centroïde (px) et de la pose (IMU/calibration, degrés) : donnent
# la covariance de chaque point 3D transmise au Kalman.
FUSION_PIXEL_SIGMA=1.5
FUSION_POSE_SIGMA_DEG=0.5
# Association multi-cibles
FUSION_ASSOC_GATE_PX=40
FUSION_PAIR_GATE_PX=60
FUSION_MAX_BLOBS_PER_CAMERA=8
FUSION_MAX_TARGETS=8
# Kalman tracker (SCRUM-59) + WS track_update (SCRUM-60)
FUSION_TRACK_MATCH_M=6
FUSION_TRACK_PROCESS_NOISE=200
FUSION_TRACK_MEAS_NOISE=2.5
FUSION_TRACK_CONFIRM=3
FUSION_TRACK_MAX_COAST_MS=1200
FUSION_TRACK_MAX_SPEED_MPS=120
FUSION_TRACK_GATE_CHI2=11.34
FUSION_TRACK_MEAS_FLOOR_M=0.05
# Diffusion WebSocket fuse_update : au plus une toutes les N ms.
FUSE_BROADCAST_MS=50
# Enregistre chaque observation (JSONL) pour le rejeu hors ligne :
#   node dist/fusion-replay.js session.jsonl --truth x,y,z
# FUSION_RECORD_PATH=/data/fusion-session.jsonl

# One full-resolution image from every Pi when a fused point is close.
CLASSIFICATION_ENABLED=true
CLASSIFICATION_CAMERA_IDS=jean,tanel,walid
CLASSIFICATION_NEAR_M=8
CLASSIFICATION_RESET_MS=2000
CLASSIFICATION_CAPTURE_TIMEOUT_MS=3000

# Journal des pistes/alertes (accuracy, historique) : fichiers JSONL écrits dans
# ALERTS_DATA_DIR (défaut ./data ; docker-compose.yml le fixe à /app/data).
# ALERTS_DATA_DIR=./data
